# ============================================
# Trigantara — Konfigurasi Lingkungan
# ============================================
# Salin berkas ini menjadi .env lalu isi nilainya.
# JANGAN pernah meng-commit berkas .env yang sudah terisi.

# Port server lokal. Di Cloud Run nilai ini disuntikkan otomatis —
# jangan ditetapkan di sana.
PORT=8080

# --------------------------------------------
# Supabase — Project Settings > API
# --------------------------------------------
SUPABASE_URL=

# RAHASIA. Melewati seluruh aturan keamanan basis data.
# Hanya boleh ada di server, tidak pernah di kode frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Dua nilai berikut dikirim ke peramban, jadi memang boleh terlihat publik.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --------------------------------------------
# Cloudflare R2 — R2 > Manage API Tokens
# --------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=trigantara

# Alamat publik bucket, tanpa garis miring di akhir.
# R2 > bucket > Settings > Public Development URL
R2_PUBLIC_URL=
VITE_R2_PUBLIC_URL=
