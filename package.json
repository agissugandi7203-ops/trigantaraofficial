{
  "name": "trigantara",
  "version": "1.0.0",
  "description": "Website resmi Gugus Depan Pramuka Trigantara — SMK Marhas Margahayu",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "npm run build:web && npm run build:server",
    "build:web": "tsx scripts/generate-sitemap.ts && vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --target=node22 --format=cjs --sourcemap --outfile=dist/server.cjs --external:vite",
    "start": "node dist/server.cjs",
    "preview": "npm run build && cross-env NODE_ENV=production node dist/server.cjs",
    "lint": "npm run lint:web && npm run lint:server",
    "lint:web": "tsc --noEmit -p tsconfig.json",
    "lint:server": "tsc --noEmit -p tsconfig.server.json",
    "seed": "tsx scripts/seed.ts",
    "seed:dry": "tsx scripts/seed.ts --dry-run",
    "check:links": "tsx scripts/check-links.ts",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@aws-sdk/s3-request-presigner": "^3.1111.0",
    "@supabase/supabase-js": "^2.112.3",
    "archiver": "^8.0.0",
    "compression": "^1.8.1",
    "dompurify": "^3.4.13",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/archiver": "^8.0.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.0.5",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "~5.8.2",
    "vite": "^8.2.1"
  }
}
